  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@synoro/tailwind-config": "workspace:*",
    "@synoro/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
