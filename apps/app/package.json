{
  "name": "@synoro/app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun --env-file=../../.env run next build",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "dev": "bun --env-file=../../.env run next dev",
    "e2e": "playwright test",
    "format": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "start": "bun --env-file=../../.env run next start",
    "test": "bun test src",
    "typecheck": "bun --env-file=../../.env run next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.5",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@orpc/client": "2.0.0-beta.50",
    "@orpc/opentelemetry": "2.0.0-beta.50",
    "@orpc/server": "2.0.0-beta.50",
    "@orpc/tanstack-query": "2.0.0-beta.50",
    "@synoro/api": "workspace:*",
    "@synoro/auth": "workspace:*",
    "@synoro/config": "workspace:*",
    "@synoro/db": "workspace:*",
    "@synoro/jobs": "workspace:*",
    "@synoro/storage": "workspace:*",
    "@synoro/ui": "workspace:*",
    "@synoro/validators": "workspace:*",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^9.3.1",
    "@vercel/otel": "^2.3.0",
    "better-auth": "1.7.19",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "posthog-js": "^1.447.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "^3.10.1",
    "server-only": "0.0.1",
