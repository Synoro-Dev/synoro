{
  "name": "@synoro/admin",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun --env-file=../../.env run next build",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "dev": "bun --env-file=../../.env run next dev --port 3001",
    "format": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "start": "bun --env-file=../../.env run next start --port 3001",
    "test": "bun test src",
    "typecheck": "bun --env-file=../../.env run next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.3",
    "@orpc/server": "2.0.0-beta.49",
    "@synoro/api": "workspace:*",
    "@synoro/auth": "workspace:*",
    "@synoro/config": "workspace:*",
    "@synoro/db": "workspace:*",
    "@synoro/jobs": "workspace:*",
    "@synoro/ui": "workspace:*",
    "@synoro/validators": "workspace:*",
    "better-auth": "1.7.18",
    "lucide-react": "^1.66.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@synoro/tailwind-config": "workspace:*",
    "@synoro/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2"
  }
}
