{
  "name": "@acme/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun --env-file=../../.env run next build",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "dev": "bun --env-file=../../.env run next dev --port 3003",
    "format": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "start": "bun --env-file=../../.env run next start --port 3003",
    "typecheck": "bun --env-file=../../.env run next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@acme/config": "workspace:*",
    "@acme/ui": "workspace:*",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@acme/tailwind-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2"
  }
}
