# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to `.env`.
#
# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Default matches the local Postgres from `docker-compose.yml`.
# For Neon, use the `*.neon.tech` connection string (the HTTP driver is selected
# automatically). For Supabase/self-hosted, the standard `node-postgres` driver
# is used. Override the driver explicitly with DB_DRIVER if needed.
POSTGRES_URL="postgres://postgres:password@localhost:5432/acme"

# Force a specific driver: "node" (node-postgres/TCP) or "neon-http".
# Leave empty to auto-detect from POSTGRES_URL.
# DB_DRIVER=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# App URL (used in emails and metadata)
APP_URL=http://localhost:3000

NEXT_PUBLIC_APP_NAME="Acme Inc."
NEXT_PUBLIC_APP_SHORT_NAME="Acme"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Practice pages on their own hosts (docs/custom-domains.md).
# `<slug>.<root>` opens a practice's booking page. Locally `localhost` works
# out of the box: http://anna.localhost:3000. Unset: no platform subdomains.
PRACTICE_ROOT_DOMAIN=localhost
# Where specialists point their own domains: CNAME for a subdomain
# (zapis.anna.ru), A record for an apex domain (anna.ru).
# CUSTOM_DOMAIN_CNAME=domains.example.com
# CUSTOM_DOMAIN_IP=203.0.113.10

# Marketing landing (apps/web): its own URL for metadata, and an optional live
# booking page for the "demo" buttons (hidden when unset). Locally, after
# `bun db:seed`: http://localhost:3000/p/klyuev
NEXT_PUBLIC_SITE_URL=http://localhost:3003
# NEXT_PUBLIC_DEMO_URL=
# Yandex Metrika counter id for the landing (Yandex Direct goals)
# NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Optional: point the web client at a standalone API server (apps/app-server).
# Leave empty to use the built-in Next.js route handler at /api/orpc.
# NEXT_PUBLIC_API_URL=http://localhost:7000

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -base64 32
# Leave empty here so a weak default is never shipped by accident.
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET=

# Preconfigured Google OAuth provider (optional)
# @see https://www.better-auth.com/docs/authentication/google
AUTH_GOOGLE_ID=''
AUTH_GOOGLE_SECRET=''

# Bootstrap admins (comma-separated): these accounts get the "admin" role on
# sign-up/sign-in. Further admins are assigned via authClient.admin.setRole.
# ADMIN_EMAILS=admin@example.com,ops@example.com

# Serve the app from several (sub)domains, e.g. app.synoro.ru + synoro.ru/p/:
# share the session cookie on the parent domain and trust the other origins.
# APP_URL stays the main origin (OAuth callbacks, emails).
# AUTH_COOKIE_DOMAIN=.synoro.ru
# AUTH_TRUSTED_ORIGINS=https://synoro.ru

# Rename the auth cookies (default prefix "better-auth") when another
# deployment's cookies reach this host, e.g. demo.synoro.ru next to
# production's AUTH_COOKIE_DOMAIN=.synoro.ru.
# AUTH_COOKIE_PREFIX=synoro-demo

# Demo stand (demo.synoro.ru): skip the sign-in pages and sign every visitor
# in as this seeded account (`bun db:seed` creates it; only @example.com
# accounts without the admin role are accepted). Never set it on a deployment
# with real users.
# DEMO_LOGIN_EMAIL=klyuev@example.com

# -----------------------------------------------------------------------------
# Online payments (ЮKassa / Т-Банк, connected by each specialist)
# -----------------------------------------------------------------------------
# Encrypts the specialists' merchant keys in the database. Generate with:
# openssl rand -base64 32. Keep it stable: changing it makes stored keys
# unreadable (specialists would reconnect). Unset: payments are off.
# Provider notifications go to <APP_URL>/api/payments/<yookassa|tbank>.
# PAYMENTS_SECRET_KEY=

# -----------------------------------------------------------------------------
# Email (local sandbox via inbucket from docker-compose)
# -----------------------------------------------------------------------------
EMAIL_SANDBOX_ENABLED=true
EMAIL_SANDBOX_HOST=localhost
# RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Storage (S3 / local MinIO from docker-compose)
# -----------------------------------------------------------------------------
# AWS_S3_ENDPOINT=http://localhost:9002
# AWS_S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=minio
# AWS_SECRET_ACCESS_KEY=password
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=files.acme.com

# -----------------------------------------------------------------------------
# Hatchet (background jobs, durable workflows, DAG orchestration)
# @see https://docs.hatchet.run
# -----------------------------------------------------------------------------
# JWT token from https://cloud.onhatchet.run → Settings → API Tokens
# (or your self-hosted Hatchet instance). Leave empty to run background work
# (e.g. emails) inline in the app; set it and run `bun jobs:dev` for the worker.
HATCHET_CLIENT_TOKEN=

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
# LOG_LEVEL=debug
# OTLP collector for traces (Next.js + oRPC spans; HTTP/protobuf), e.g. a local
# Jaeger/Grafana Alloy at http://localhost:4318. Log lines carry trace_id.
# OTEL_EXPORTER_OTLP_ENDPOINT=
