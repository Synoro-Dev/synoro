{
  "name": "@synoro/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown && tsc --tsBuildInfoFile dist/.tsbuildinfo",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc --tsBuildInfoFile dist/.tsbuildinfo",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@synoro/config": "workspace:*",
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0"
  },
  "devDependencies": {
    "@synoro/tsconfig": "workspace:*",
    "@types/node": "26.6.5",
    "tsdown": "0.23.2",
    "typescript": "7.0.2"
  }
}
