{
  "name": "@synoro/emails",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    ".react-email"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "dev:email": "bun --env-file=../../.env run email dev -p 3002",
    "build": "tsdown && tsc --tsBuildInfoFile dist/.tsbuildinfo",
    "export": "email export",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@synoro/config": "workspace:*",
    "nodemailer": "^10.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.5",
    "resend": "^6.35.0"
  },
  "devDependencies": {
    "@react-email/preview-server": "5.2.10",
    "@synoro/tsconfig": "workspace:*",
    "@types/node": "26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsdown": "0.23.3",
    "typescript": "7.0.2"
  }
}
