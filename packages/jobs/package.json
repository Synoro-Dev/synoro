{
  "name": "@synoro/jobs",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./workflows": {
      "types": "./dist/workflows/index.d.ts",
      "default": "./src/workflows/index.ts"
    },
    "./booking-video": {
      "types": "./dist/booking-video.d.ts",
      "default": "./src/booking-video.ts"
    },
    "./google-calendar": {
      "types": "./dist/google-calendar.d.ts",
      "default": "./src/google-calendar.ts"
    },
    "./pro-notices": {
      "types": "./dist/pro-notices.d.ts",
      "default": "./src/pro-notices.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "worker": "bun --env-file=../../.env --watch run src/worker.ts",
    "start": "bun run src/worker.ts",
    "format": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@hatchet-dev/typescript-sdk": "1.44.2",
    "@synoro/config": "workspace:*",
    "@synoro/db": "workspace:*",
    "@synoro/emails": "workspace:*",
    "@synoro/validators": "workspace:*"
  },
  "devDependencies": {
    "@synoro/tsconfig": "workspace:*",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
