{
  "name": "@synoro/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@orpc/server": "2.0.0-beta.47",
    "@synoro/auth": "workspace:*",
    "@synoro/config": "workspace:*",
    "@synoro/db": "workspace:*",
    "@synoro/validators": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@synoro/tsconfig": "workspace:*",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
